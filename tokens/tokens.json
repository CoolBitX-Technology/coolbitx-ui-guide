{
  "$description": "CoolBitX / CoolWallet brand primitives in W3C Design Tokens format. Mirrors tokens/tokens.css layer 1. 'source' says which guide each value comes from.",
  "coolwallet": {
    "yellow":   { "$type": "color", "$value": "#F7B419", "source": "2025 New Brand Guidelines" },
    "navy":     { "$type": "color", "$value": "#1C324A", "source": "2025 New Brand Guidelines (also Darkmode background)" },
    "gray":     { "$type": "color", "$value": "#939393", "source": "2025 New Brand Guidelines" },
    "charcoal": { "$type": "color", "$value": "#1B202A", "source": "2025 New Brand Guidelines" },
    "ink":      { "$type": "color", "$value": "#1A1A1A", "source": "dark logo SVG fill" },
    "paper":    { "$type": "color", "$value": "#E6E6E6", "source": "guide page background" }
  },
  "coolwallet-pro": {
    "gold":      { "$type": "color", "$value": "#C69C6D", "source": "2020 CoolWallet guide, Pro swatch" },
    "gold-deep": { "$type": "color", "$value": "#A87E53", "source": "sampled midpoint of Pro gold gradient" },
    "gradient-gold":   { "$type": "gradient", "$value": [{ "color": "#C69C6D", "position": 0 }, { "color": "#A87E53", "position": 0.5 }, { "color": "#C69C6D", "position": 1 }], "angle": "225deg", "source": "sampled from 2020 guide" },
    "gradient-silver": { "$type": "gradient", "$value": [{ "color": "#E5E5E5", "position": 0 }, { "color": "#D1D1D1", "position": 0.5 }, { "color": "#E5E5E5", "position": 1 }], "angle": "45deg", "source": "sampled from 2020 guide" },
    "gradient-dark":   { "$type": "gradient", "$value": [{ "color": "#2D3944", "position": 0 }, { "color": "#11181E", "position": 1 }], "angle": "90deg", "source": "sampled from 2020 guide" }
  },
  "coolwallet-s-legacy": {
    "yellow": { "$type": "color", "$value": "#FEBA11", "source": "CoolWallet S logo file" }
  },
  "coolbitx": {
    "gold":     { "$type": "color", "$value": "#AA8E4E", "source": "CoolBitX Brand Guidelines (logo SVG uses #AF9241)" },
    "gray":     { "$type": "color", "$value": "#939393", "source": "CoolBitX Brand Guidelines" },
    "charcoal": { "$type": "color", "$value": "#1B202A", "source": "CoolBitX Brand Guidelines" }
  },
  "font": {
    "coolwallet-display": { "$type": "fontFamily", "$value": ["Montserrat", "Helvetica Neue", "Arial", "sans-serif"] },
    "coolwallet-body":    { "$type": "fontFamily", "$value": ["Barlow", "Helvetica Neue", "Arial", "sans-serif"] },
    "coolbitx-primary":   { "$type": "fontFamily", "$value": ["Open Sans", "Helvetica Neue", "Helvetica", "Arial", "sans-serif"] },
    "coolbitx-secondary": { "$type": "fontFamily", "$value": ["Helvetica Neue", "Helvetica", "Arial", "sans-serif"] }
  }
}
